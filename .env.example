# --- Database (Supabase > Project Settings > Database) ---
# Pooled connection string (port 6543, pgbouncer) — used by the app at runtime
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection string (port 5432) — used by prisma migrate
DIRECT_URL="postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# --- Supabase Storage (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon key>"
SUPABASE_SERVICE_ROLE_KEY="<service role key — server only, never exposed>"

# --- Auth ---
# Any long random string, e.g. `openssl rand -base64 32`
JWT_SECRET="change-me-to-a-long-random-string"
# Salt for hashing client IPs used in rate limiting — set to a random string in
# prod so the hashes aren't guessable. Falls back to a fixed default if unset.
IP_HASH_SALT="change-me-to-a-random-string"

# --- Email (Resend) ---
# Leave RESEND_API_KEY empty to log emails to the console instead of sending
RESEND_API_KEY=""
# Sender — must be on a domain verified in Resend (e.g. support@premierenergies.com)
EMAIL_FROM="Premier Energies <support@premierenergies.com>"
# Internal after-sales team inbox that receives new-complaint alerts
AFTER_SALES_EMAIL="aftersales@premierenergies.com"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
